<!--components/common/color-picker-drawer/index.wxml-->
<view class="color-picker-drawer {{show ? 'show' : ''}}" bindtap="onClose">
  <view class="drawer-content" catchtap="preventBubble">
    <!-- 抽屉头部 -->
    <view class="drawer-header">
      <view class="drawer-title">选择颜色</view>
      <close-icon bind:close="onClose"  top="4" right="8" />
    </view>

    <!-- 颜色选择器 -->
    <view class="color-picker-container">
      <color-picker 
        value="{{currentColor}}"
        disabled="{{disabled}}"
        bindchange="onColorChange"
      />
    </view>

    <view class='preset-colors'>
     <view class='preset-colors-list'>
        <view wx:for="{{presetColors}}" class='preset-color-item' style="background-color: {{item}}" catch:tap="onPresetColorClick" data-color="{{item}}"></view>
      </view>
    </view>
                
    <!-- 操作按钮 -->
    <view class="drawer-actions">
      <ckt-button text="取消" bind:tap="onCancel" block/>
      <ckt-button text="确定" bind:tap="onConfirm" block/>
    </view>
  </view>
</view>
