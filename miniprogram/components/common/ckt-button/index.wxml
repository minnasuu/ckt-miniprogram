<button 
  class="ckt-button {{type}} {{size}} {{customClass}}"
  disabled="{{disabled || loading}}"
  bindtap="onTap"
  style="{{style}}"
>
  <view class="button-content">
    <view wx:if="{{loading}}" class="loading-icon">
      <view class="loading-spinner"></view>
    </view>
    <text class="button-text">{{loading ? loadingText : text}}</text>
  </view>
</button>
