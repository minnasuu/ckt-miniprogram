.content-grid {
  display: flex;
  gap: 12px;
  padding: 12px;
}

.grid-column{
  flex: 1;
  width: 1%;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.grid-item {
  position: relative;
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  padding: 8px 12px;
  background-color: var(--ckt-gray-1);
  box-sizing: border-box;
}

.item-image {
  width: 100%;
}
.item-image image{
  border-radius: 8px;
  overflow: hidden;
}

.item-info {
  padding-block: 8px;
}

.item-title {
  font-size: 14px;
  color: #333;
  margin-bottom: 6px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  margin-right: 8rpx;
}

.author-name {
  font-size: 12px;
  color: var(--ckt-gray-12);
}

.tag {
  font-size: 20rpx;
  color: var(--ckt-gray-6);
  background: var(--ckt-gray-2);
  padding: 4rpx 6px;
  border-radius: 8rpx;
} 

.button-mask{
  position: absolute;
  top: 0%;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  color: var(--ckt-gray-12);
  font-size: 12px;
  background-color: rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(8rpx);
}

.button-mask .btn{
  padding: 9rpx 12px;
  background-color: rgba(255,255,255,0.5);
  border-radius: 8rpx;
}

/* 图解笔记类型样式 */
.pattern-image {
  border-radius: 6px;
}

.pattern-badge {
  position: absolute;
  top: 6px;
  right: 6px;
  background: rgba(255, 87, 34, 0.9);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
}

.pattern-btn {
  background: #ff5722;
  color: #fff;
}

/* 教程类型样式 */
.tutorial-image {
  border-radius: 6px;
}

.tutorial-badge {
  position: absolute;
  top: 6px;
  right: 6px;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
}

.badge-text {
  color: #fff;
  font-size: 20rpx;
}

.tutorial-btn {
  background: var(--ckt-primary-color, #007aff);
  color: #fff;
}