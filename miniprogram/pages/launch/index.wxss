.launch-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 0 60rpx;
}

.welcome-content {
  text-align: center;
  margin-bottom: 80rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--ckt-gray-12);
  margin-top: 40rpx;
  letter-spacing: 2rpx;
}

.loading-indicator {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--ckt-theme-6);
  animation: loading 1.4s infinite ease-in-out;
}

.loading-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.loading-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes loading {
  0%, 80%, 100% {
    opacity: 0;
  }
  40% {
    opacity: 1;
  }
}
