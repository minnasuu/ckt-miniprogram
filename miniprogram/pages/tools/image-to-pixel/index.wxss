.tools-view {
  width: 100vw;
  height: 100vh;
  background-color: #fff;
  display: flex;
  flex-direction: column;
}
.tools-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  padding-inline: 24px;
  box-sizing: border-box;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom, 12px);
}
.tools-step-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  flex-shrink: 0;
}
.filter-panel {
  display: flex;
  align-items: center;
  gap: 40rpx;
  width: 100%;
}
.filter-panel .filter-left {
  flex: 1;
  width: 1%;
  display: flex;
  gap: 8rpx;
  align-items: center;
  font-size: 12px;
  color: var(--ckt-geay-12);
  white-space: nowrap;
}
.filter-panel .filter-left .range-slider {
  flex: 1;
  width: 1%;
}
.filter-panel .filter-right {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--ckt-geay-12);
}
.filter-panel .filter-right button.start-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 36px;
  padding: 0;
  margin: 0;
  font-size: 14px;
  background-color: var(--ckt-theme-6);
  color: var(--ckt-gray-0);
  border-radius: 8px;
}
.filter-panel .filter-right button.start-button[disabled] {
  background-color: var(--ckt-gray-2);
  color: var(--ckt-gray-5);
}
.img-to-pixel-result-puzzle {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}
.img-to-pixel-result-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  align-items: center;
  font-size: 12px;
  color: var(--ckt-gray-10);
}
.img-to-pixel-result-card .pixel-card {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  background-color: var(--ckt-gray-1);
  border-radius: 12px;
}
.img-to-pixel-result-card .pixel-card image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.img-to-pixel-result-card .pixel-card .pixel-loading {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s linear;
  z-index: 1;
}
.img-to-pixel-result-card .pixel-card .pixel-loading.hide {
  opacity: 0;
  pointer-events: none;
}
.img-to-pixel-result-card .bottom-buttons {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
}
.img-to-pixel-result-card .bottom-buttons button {
  border-radius: 8px;
  height: 72rpx;
  padding-inline: 24px;
  font-size: 14px;
}
.img-to-pixel-result-card .bottom-buttons button.download {
  flex: 1;
  background-color: var(--ckt-gray-1);
  color: var(--ckt-gray-10);
}
.img-to-pixel-result-card .bottom-buttons button.download[disabled] {
  background-color: var(--ckt-gray-2);
  color: var(--ckt-gray-5);
}
.img-to-pixel-result-card .bottom-buttons button.save {
  flex: 1;
  background-color: var(--ckt-theme-6);
  color: var(--ckt-gray-0);
}
.img-to-pixel-result-card .bottom-buttons button.save[disabled] {
  background-color: var(--ckt-theme-3);
}
.alert-text {
  font-size: 12px;
  color: var(--ckt-gray-6);
  text-align: center;
  margin-top: auto;
}
