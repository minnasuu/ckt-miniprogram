<view class="pixel-canvas-container">
  <custom-header title="像素画板" showBack customBackHandler bindcustomBack="onCustomBack"></custom-header>
  <view class="content">
    <!-- 画布区域 -->
    <view class="canvas-container">
      <view class="pixel-canvas" 
            style="width: {{canvasWidth*Math.min(screenWidth/(canvasWidth||12),24)-2}}px;height:{{canvasHeight*Math.min(screenWidth/(canvasWidth||12),24)}}px"
            bindtouchstart="onTouchStart"
            bindtouchmove="onTouchMove"
            bindtouchend="onTouchEnd"
            catchtouchmove="onTouchMove">
        <view class="canvas-row" wx:for="{{canvasData}}" wx:for-item="row" wx:for-index="y" wx:key="y">
          <view class="pixel" wx:for="{{row}}" wx:for-item="pixel" wx:for-index="x" wx:key="x" 
              style="background-color: {{pixel}}; width: {{screenWidth/canvasWidth}}px; max-width:24px;border-color:{{borderStyle === '1'?'transparent':borderStyle ==='2'?canvasColor:'#DDDDDD'}};" 
              bindtap="drawPixel" 
              data-x="{{x}}" 
              data-y="{{y}}"
            ></view>
        </view>
      </view>
    </view>

  <view class="option-container">
    <view class="option-item">
      <text class="title">设置画布大小</text>
      <view class="canvas-size-selector">
        <view class="size-options">
          <view wx:for="{{canvasSizeOptions}}" 
                wx:key="index"
                class="size-option {{canvasWidth === item.width && canvasHeight === item.height ? 'active' : ''}}"
                bindtap="onCanvasSizeSelect"
                data-width="{{item.width}}"
                data-height="{{item.height}}">
            {{item.label}}
          </view>
        </view>
      </view>
    </view>

    <view class="option-item">
      <text class="title">画笔颜色</text>
      <view class="option-content">
        <view class="color-block-container" bindtap="showBrushColorPicker" data-type="brush">
          <view class="color-block" style="background-color: {{brushColor}}"><view class="text">{{brushColor}}</view></view>
        </view>
        <button disabled="{{isCanvasEmpty}}" class="eraser-button {{isEraser?'active':''}}" bindtap="eraserChange"><view class="eraser-icon"></view></button>
      </view>
    </view>

    <!--<view class="option-item">
      <text class="title">画笔图样</text>
        <view class="brush-pattern-list">
          <view class="brush-pattern-item empty"></view>
          <view wx:for="{{brushPatternData}}" wx:key="index" class="brush-pattern-item"></view>
        </view>
    </view>-->

      <view style="display:flex;gap:24px;width:100%">
        <view class="option-item" style="flex:1">
          <text class="title">画布颜色</text>
          <view class="color-block-container" bindtap="showCanvasColorPicker" data-type="canvas">
            <view class="color-block" style="background-color: {{canvasColor}}"><view class="text">{{canvasColor}}</view></view>
          </view>
        </view>
        <view class="option-item" style="flex:1">
          <text class="title">网格线颜色</text>
          <view class="grid-style-select-list">
            <view wx:for="{{gridStyleList}}" wx:key="index" bind:tap="onGridShowChange" data-type="{{item}}" class="grid-style-select-item {{item === '1'?'transparent':''}} {{borderStyle === item ? 'active':''}}" style="background-color: {{item === '1' ? '' : item === '2' ? canvasColor:'var(--ckt-gray-2)'}}"></view>
          </view>
        </view>
      </view>

    <!-- 工具栏 -->
    <view class="toolbar">
      <button class="tool-button" bindtap="clearCanvas" disabled="{{saveLoading || isCanvasEmpty}}">清空画布</button>
      <ckt-button 
        text="下载图片" 
        type="primary" 
        disabled="{{isCanvasEmpty}}" 
        bind:tap="downloadCanvas" 
      />
       <!-- <button class="tool-button" type="primary" bindtap="saveCanvas" disabled="{{saveLoading || isCanvasEmpty}}">{{saveLoading?'保存中...':'保存图片'}}</button> -->
    </view>
    </view>
  </view>
  <movable-area scale-area class="full-pixel-canvas-container {{fullCanvas?'fullCanvas':''}}" style="padding-top: {{statusBarHeight + 44 + 12}}px;width:100vw;height:100vh;">
    <movable-view direction="all" 
                  scale 
                  scale-min="0.5" 
                  scale-max="3" 
                  scale-value="1"
                  class="pixel-canvas" 
                  x="{{(screenWidth + 48 - canvasWidth * 32)/2}}" 
                  y="{{(screenHeight+statusBarHeight - canvasHeight * 32)/2}}" 
                  style="width: {{canvasWidth*32}}px;height:{{canvasHeight*32}}px;"
                  bindchange="onMovableViewChange">
        <view class="canvas-content"
              catchtouchstart="onTouchStart"
              catchtouchmove="onTouchMove"
              catchtouchend="onTouchEnd">
          <view class="canvas-row" wx:for="{{canvasData}}" wx:for-item="row" wx:for-index="y" wx:key="y">
            <view class="pixel" wx:for="{{row}}" wx:for-item="pixel" wx:for-index="x" wx:key="x" 
                style="background-color: {{pixel}}; width: 32px;border-color:{{borderStyle === 1 ?'transparent':borderStyle==='2'? canvasColor:'var(--ckt-gray-4)'}};"
                bindtap="drawPixel" 
                data-x="{{x}}" 
                data-y="{{y}}"
              ></view>
          </view>
        </view>
      </movable-view>
      <button class="zoom-out-button" style="width: 34px" bind:tap="onZoomOutCanvas"><view class="zoom-out-icon"></view></button>
  </movable-area>
  <canvas canvas-id="result-canvas" id="result-canvas" type="2d" style="display:none;width: {{canvasWidth*32}}px;height:{{canvasHeight*32}}px;"></canvas>
  

  <!-- 颜色选择器抽屉 -->
  <color-picker-drawer
    show="{{showColorPicker}}"
    value="{{currentPickerColor}}"
    bindclose="onColorPickerClose"
    bindcancel="onColorPickerCancel"
    bindconfirm="onColorPickerConfirm"
    bindchange="onColorPickerChange"
  />

  <!-- 权限不足提示弹窗 -->
  <dialog
    visible="{{showPermissionDialog}}"
    title="权限不足"
    content="保存功能仅限高级用户使用，基础用户暂不支持此功能。"
    showCancel="{{false}}"
    confirmText="我知道了"
    bindconfirm="onPermissionDialogClose"
    bindclose="onPermissionDialogClose"
  />

  <dialog
    visible="{{showClearCanvasDialog}}"
    title="确定清空画布？"
    content="清空画布后，画布上的所有像素都将被清除。"
    confirmText="确定"
    bindconfirm="onClearCanvas"
    bindclose="onClearCanvasClose"
  />

  <!-- 退出确认对话框 -->
  <dialog
    visible="{{showExitDialog}}"
    title="退出提示"
    content="检测到您有未保存的绘画数据，退出后将清除绘画数据。"
    confirmText="直接退出"
    cancelText="缓存到本地"
    showCancel="{{true}}"
    bindconfirm="onDirectExit"
    bindcancel="onCacheAndExit"
    bindclose="onCancelExit"
  />
</view>