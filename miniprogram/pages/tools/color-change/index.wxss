/* pages/tools/color-change/index.wxss */
.color-change-container {
  width: 100vw;
  height: 100vh;
  background-color: #fff;
  box-sizing: border-box;
  position: relative;
  z-index: 0;
}
.color-change-container .color-change-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-inline: 48rpx;
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
  overflow: auto;
  box-sizing: border-box;
}
.step-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
  flex-shrink: 0;
}
.upload-section {
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
}
.color-list {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 auto;
}
.color-list span {
  font-size: 24rpx;
  color: var(--ckt-gray-8);
}
.color-list .color-item {
  width: 20px;
  height: 20px;
  border-radius: 8rpx;
}
.buttons-container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.buttons-container button {
  width: 100px;
  height: 36px;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.canvas-container {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  isolation: isolate;
  pointer-events: none;
}
.canvas-container canvas {
  position: relative;
  z-index: 1;
}
.canvas-container image {
  width: 100%;
}
/* 清除按钮禁用状态样式 */
.clear-button:disabled {
  background-color: var(--ckt-gray-2);
  color: var(--ckt-gray-6);
  cursor: not-allowed;
  opacity: 0.6;
}
button {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
}
/* 下载和保存按钮样式 */
.download-button {
  background-color: var(--ckt-gray-2);
  color: var(--ckt-gray-11);
}
.download-button[disabled] {
  color: var(--ckt-gray-6);
}
.generate-button[type="primary"],
.save-button[type="primary"] {
  background-color: var(--ckt-theme-6);
  color: var(--ckt-gray-0);
}
.generate-button[type="primary"][disabled],
.save-button[type="primary"][disabled] {
  background-color: var(--ckt-theme-4);
  color: var(--ckt-gray-0);
}
