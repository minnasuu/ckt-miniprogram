<view class="documents-container">
  <custom-header title="我的图解" showBack back-url="/pages/user-center/index"></custom-header>
  
  <!-- 内容区域 -->
  <view class="content-container">
    <!-- 加载状态 -->
    <view wx:if="{{documentLoading}}" class="loading-state">
      <loading></loading>
      <text class="loading-text">正在加载图解...</text>
    </view>
    
    <!-- 错误状态 -->
    <view wx:elif="{{documentError}}" class="error-state">
      <text class="error-text">{{documentErrorMsg}}</text>
      <button class="retry-btn" bindtap="onRetryLoad">重试</button>
    </view>
    
    <!-- 未登录状态 -->
    <view wx:elif="{{!isLoggedIn}}" class="login-required-state">
      <text class="login-title">请先登录</text>
      <text class="login-desc">登录后可查看你的图解</text>
      <button class="login-btn" bindtap="gotoLogin">去登录</button>
    </view>
    
    <!-- 空状态 -->
    <view wx:elif="{{documentList.length === 0}}" class="empty-state">
      <text class="empty-title">暂无图解</text>
      <text class="empty-desc">去图解笔记本创作你的第一个图解</text>
      <button class="goto-btn" bindtap="gotoPatternNote">去创作</button>
    </view>
    
    <!-- 数据列表 -->
    <block wx:else>
      <view class="pattern-list">
        <view wx:for="{{documentList}}" class="pattern-card">
          <view class="pattern-card-container">
          <view class="pattern-card-title">{{item.title}}</view>
          <view class="pattern-card-info">
          <view class="pattern-card-desc">部分：{{item.data.length}}</view>
            <view class="pattern-card-desc">字符：{{item.dataStrs}}</view>
            <view class="pattern-card-time">创建：{{item.createTime}}</view>
            <view class="pattern-card-time">更新：{{item.updateTime}}</view>
          </view>
          </view>
          <view class="pattern-card-actions">
            <button class="pattern-card-action-btn" bindtap="onEditTap" data-id="{{item._id}}">编辑</button>
            <button class="pattern-card-action-btn delete" bindtap="onItemDeleteTap" data-id="{{item._id}}">删除</button>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
