.documents-container {
  min-height: 100vh;
  box-sizing: border-box;
}

.content-container {
  min-height: calc(100vh - 132px);
  box-sizing: border-box;
  padding: 16px;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 42vh;
}

.loading-text {
  margin-top: 20rpx;
  color: var(--ckt-gray-9);
  font-size: 14px;
}

/* 错误状态 */
.error-state {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding-top: 42vh;
  color: var(--ckt-gray-9);
  font-size: 14px;
}

.retry-btn:not([size=mini]) {
  width: fit-content;
  margin: 0;
  padding: 0;
  color: var(--ckt-theme-6);
  font-size: 14px;
  line-height: 1.5rem;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 42vh;
}

.empty-title {
  color: var(--ckt-gray-9);
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.empty-desc {
  color: var(--ckt-gray-9);
  font-size: 14px;
  margin-bottom: 30rpx;
  text-align: center;
}

.goto-btn {
  border: 1px solid var(--ckt-theme-2);
  color: var(--ckt-theme-6);
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 14px;
}

/* 未登录状态 */
.login-required-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 42vh;
}

.login-icon {
  font-size: 40px;
  margin-bottom: 20rpx;
}

.login-title {
  color: var(--ckt-gray-9);
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.login-desc {
  color: var(--ckt-gray-9);
  font-size: 14px;
  margin-bottom: 30rpx;
  text-align: center;
}

.login-btn {
  border: 1px solid var(--ckt-theme-2);
  color: var(--ckt-theme-6);
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 14px;
}

.pattern-list{
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pattern-card{
  display: flex;
  gap: 8px;
  width: 100%;
}

.pattern-card-container{
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px 16px;
  background-color: var(--ckt-gray-1);
  border-radius: 12px;
}

.pattern-card-actions{
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
}

.pattern-card-title{
  font-size: 14px;
  font-weight: bold;
}

.pattern-card-info{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.pattern-card-desc{
  font-size: 12px;
  color: var(--ckt-gray-9);
}

.pattern-card-time{
  font-size: 12px;
  color: var(--ckt-gray-9);
}

.pattern-card-action-btn:not([size=mini]){
  flex: 1;
  width: 48px;
  height: 1%;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: var(--ckt-gray-11);
  border: 2rpx solid var(--ckt-gray-2);
  border-radius: 8px;
}
.pattern-card-action-btn:not([size=mini]).delete{
  color: var(--ckt-red-5);
  border-color: var(--ckt-red-1);
}