<view class="assets-container">
  <custom-header title="我的资产" showBack back-url="/pages/user-center/index"></custom-header>
  
  <!-- 内容区域 -->
  <view class="content-container">
    <!-- 未登录状态 -->
    <view wx:if="{{!isLoggedIn}}" class="login-required-state">
      <view class="login-icon">🔐</view>
      <text class="login-title">请先登录</text>
      <text class="login-desc">登录后可查看你的资产管理</text>
      <button class="login-btn" bindtap="gotoLogin">去登录</button>
    </view>
    
    <!-- 即将推出状态 -->
    <view wx:else class="coming-soon-state">
      <view class="coming-icon">📦</view>
      <text class="coming-title">即将推出</text>
      <text class="coming-desc">资产管理功能正在开发中，敬请期待</text>
    </view>
  </view>
</view>
