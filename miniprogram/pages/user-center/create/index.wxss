.publish-container {
  min-height: 100vh;
  background: var(--ckt-gray-0);
  padding-top: 176rpx;
  box-sizing: border-box;
  overflow: auto;
}

.tab-container {
  position: sticky;
  z-index: 10;
  background: var(--ckt-gray-0);
  padding: 12px 20px;
  border-bottom: 2rpx solid var(--ckt-gray-2);
}

.content-container {
  flex: 1;
  position: relative;
}

.tab-content {
  min-height: calc(100vh - 240rpx);
  position: relative;
  padding-bottom: calc(env(safe-area-inset-bottom) + 80px);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  width: 100%;
  padding: 48rpx;
}

.loading-text {
  color: var(--ckt-gray-7);
  font-size: 28rpx;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  width: 100%;
  padding: 48rpx;
}

.error-icon {
  font-size: 80rpx;
}

.error-text {
  color: var(--ckt-gray-8);
  font-size: 28rpx;
  text-align: center;
  line-height: 1.5;
}

.retry-btn {
  background: var(--ckt-primary-color, #007aff);
  color: #fff;
  border: none;
  border-radius: 24rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  padding: 48rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}

.empty-title {
  color: var(--ckt-gray-10);
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.empty-desc {
  color: var(--ckt-gray-7);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.goto-btn {
  background: var(--ckt-theme-6);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 12px 16px;
  font-size: 14px;
}

/* 未登录状态 */
.login-required-state {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  padding: 48rpx;
}

.login-icon {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}

.login-title {
  color: var(--ckt-gray-10);
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.login-desc {
  color: var(--ckt-gray-7);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.login-btn {
  background: #4caf50;
  color: #fff;
  border: none;
  border-radius: 24rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
}

/* 即将推出状态 */
.coming-soon-state {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  padding: 48rpx;
}

.coming-icon {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}

.coming-title {
  color: var(--ckt-gray-10);
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.coming-desc {
  color: var(--ckt-gray-7);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.5;
} 