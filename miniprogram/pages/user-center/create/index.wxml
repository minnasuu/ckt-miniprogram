<view class="publish-container">
  <custom-header title="我的创作" showBack back-url="/pages/user-center/index"></custom-header>
  
  <!-- Tab导航 -->
  <view class="tab-container">
    <nav navList="{{tabList}}" currentNav="{{currentTab}}" bind:navChange="onTabChange"></nav>
  </view>
  
  <!-- 内容区域 -->
  <view class="content-container">
    <!-- 图片列表 -->
    <view wx:if="{{currentTab === 0}}" class="tab-content">
      <!-- 加载状态 -->
      <view wx:if="{{imageLoading}}" class="loading-state">
        <loading></loading>
        <text class="loading-text">正在加载图片...</text>
      </view>
      
      <!-- 错误状态 -->
      <view wx:elif="{{imageError}}" class="error-state">
        <view class="error-icon">⚠️</view>
        <text class="error-text">{{imageErrorMsg}}</text>
        <button class="retry-btn" bindtap="onRetryLoad" data-type="images">重试</button>
      </view>
      
      <!-- 空状态 -->
      <view wx:elif="{{imageList.length === 0}}" class="empty-state">
        <view class="empty-icon">🖼️</view>
        <text class="empty-title">暂无图片作品</text>
        <text class="empty-desc">去工具页面创作你的第一个作品吧</text>
        <button class="goto-btn" bindtap="gotoTools">去创作</button>
      </view>
      
      <!-- 数据列表 -->
      <view wx:else>
        <content-grid 
          list="{{imageList}}" 
          bind:itemDeleteTap="onItemDeleteTap"
          bind:itemTap="onItemTap">
        </content-grid>
      </view>
    </view>
    
    <!-- 文档列表 -->
    <view wx:if="{{currentTab === 1}}" class="tab-content">
      <!-- 加载状态 -->
      <view wx:if="{{documentLoading}}" class="loading-state">
        <loading></loading>
        <text class="loading-text">正在加载文档...</text>
      </view>
      
      <!-- 错误状态 -->
      <view wx:elif="{{documentError}}" class="error-state">
        <view class="error-icon">⚠️</view>
        <text class="error-text">{{documentErrorMsg}}</text>
        <button class="retry-btn" bindtap="onRetryLoad" data-type="documents">重试</button>
      </view>
      
      <!-- 未登录状态 -->
      <view wx:elif="{{!isLoggedIn}}" class="login-required-state">
        <view class="login-icon">🔐</view>
        <text class="login-title">请先登录</text>
        <text class="login-desc">登录后可查看你的图解文档</text>
        <button class="login-btn" bindtap="gotoLogin">去登录</button>
      </view>
      
      <!-- 空状态 -->
      <view wx:elif="{{documentList.length === 0}}" class="empty-state">
        <view class="empty-icon">📄</view>
        <text class="empty-title">暂无图解文档</text>
        <text class="empty-desc">去图解笔记本创作你的第一个图解</text>
        <button class="goto-btn" bindtap="gotoPatternNote">去创作</button>
      </view>
      
      <!-- 数据列表 -->
      <view wx:else>
        <content-grid 
          list="{{documentList}}" 
          bind:itemDeleteTap="onItemDeleteTap"
          bind:itemTap="onItemTap">
        </content-grid>
      </view>
    </view>
    
    <!-- 资产列表 -->
    <view wx:if="{{currentTab === 2}}" class="tab-content">
      <!-- 即将推出状态 -->
      <view class="coming-soon-state">
        <view class="coming-icon">📦</view>
        <text class="coming-title">即将推出</text>
        <text class="coming-desc">资产管理功能正在开发中，敬请期待</text>
      </view>
    </view>
  </view>
</view>