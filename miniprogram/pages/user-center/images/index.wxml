<view class="images-container">
  <custom-header title="我的图片" showBack back-url="/pages/user-center/index"></custom-header>
  
  <!-- 导航栏 -->
  <view class="nav-container">
    <nav 
      navList="{{categoryList}}" 
      currentNav="{{currentCategory}}" 
      bind:navChange="onCategoryChange">
    </nav>
  </view>
  
  <!-- 内容区域 -->
  <view class="content-container">
    <!-- 加载状态 -->
    <view wx:if="{{imageLoading}}" class="loading-state">
      <loading></loading>
      <text class="loading-text">正在加载图片...</text>
    </view>
    
    <!-- 错误状态 -->
    <view wx:elif="{{imageError}}" class="error-state">
      {{imageErrorMsg}}
      <button class="retry-btn" bindtap="onRetryLoad">重试</button>
    </view>
    
    <!-- 空状态 -->
    <view wx:elif="{{imageList.length === 0}}" class="empty-state">
      <text class="empty-title">暂无图片作品</text>
      <text class="empty-desc">去工具页面创作你的第一个作品吧</text>
      <button class="goto-btn" bindtap="gotoTools">去创作</button>
    </view>
    
    <!-- 数据列表 -->
    <view wx:else>
      <content-grid 
        list="{{imageList}}" 
        bind:itemDeleteTap="onItemDeleteTap"
        bind:itemTap="onItemTap"
        >
      </content-grid>
    </view>
  </view>
</view>
<alert-message message="{{alertMessage}}" show="{{showAlert}}" type="{{alertType}}" />
