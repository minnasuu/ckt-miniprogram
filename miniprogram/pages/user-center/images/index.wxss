.images-container {
  min-height: 100vh;
  padding-top: 144rpx;
}

.content-container {
  padding: 20rpx;
  min-height: calc(100vh - 88rpx);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 42vh;
}

.loading-text {
  margin-top: 20rpx;
  color: var(--ckt-gray-9);
  font-size: 28rpx;
}

/* 错误状态 */
.error-state {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding-top: 42vh;
  color: var(--ckt-gray-9);
  font-size: 28rpx;
}

.retry-btn:not([size=mini]) {
  width: fit-content;
  margin: 0;
  padding: 0;
  color: var(--ckt-theme-6);
  font-size: 28rpx;
  line-height: 1.5rem;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 42vh;
}

.empty-title {
  color: var(--ckt-gray-9);
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.empty-desc {
  color: var(--ckt-gray-9);
  font-size: 28rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.goto-btn {
  border: 1px solid var(--ckt-theme-2);
  color: var(--ckt-theme-6);
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}
