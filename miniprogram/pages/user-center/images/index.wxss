.images-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 导航栏样式 */
.nav-container {
  display: inline-flex;
  width: 100vw;
  padding: 8px 16px;
  border-bottom: 1rpx solid var(--ckt-gray-3);
  background: #fff;
  box-sizing: border-box;
  overflow-x: auto;
}

.content-container {
  flex: 1;
  height: 1%;
  padding: 20rpx;
  overflow: auto;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 30vh;
}

.loading-text {
  margin-top: 20rpx;
  color: var(--ckt-gray-9);
  font-size: 14px;
}

/* 错误状态 */
.error-state {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding-top: 30vh;
  color: var(--ckt-gray-9);
  font-size: 14px;
}

.retry-btn:not([size=mini]) {
  width: fit-content;
  margin: 0;
  padding: 0;
  color: var(--ckt-theme-6);
  font-size: 14px;
  line-height: 1.5rem;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 30vh;
}

.empty-title {
  color: var(--ckt-gray-9);
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.empty-desc {
  color: var(--ckt-gray-9);
  font-size: 14px;
  margin-bottom: 30rpx;
  text-align: center;
}

.goto-btn {
  border: 1px solid var(--ckt-theme-2);
  color: var(--ckt-theme-6);
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 14px;
}

/* 图片预览窗口样式 */
.preview-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.9);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-container {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.preview-image {
  max-width: 90vw;
  max-height: 70vh;
  object-fit: contain;
}

.preview-controls {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 0 40rpx;
}

.preview-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.preview-title {
  color: white;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
  max-width: 80vw;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-counter {
  color: rgba(255, 255, 255, 0.8);
  font-size: 12px;
}

.preview-actions {
  display: flex;
  gap: 20rpx;
}

.preview-btn {
  background-color: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 40rpx;
  padding: 8px 16px;
  display: flex;
  align-items: center;
  gap: 8rpx;
  backdrop-filter: blur(10px);
}

.preview-btn .btn-icon {
  font-size: 12px;
}

.preview-btn .btn-text {
  color: white;
  font-size: 12px;
}

.preview-close {
  position: absolute;
  top: 120rpx;
  right: 40rpx;
  width: 40px;
  height: 40px;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
}

.close-icon {
  color: white;
  font-size: 16px;
  font-weight: bold;
}

.preview-hint {
  position: absolute;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 6px 12px;
  backdrop-filter: blur(10px);
}

.hint-text {
  color: white;
  font-size: 12px;
  opacity: 0.8;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .preview-image {
    max-width: 95vw;
    max-height: 75vh;
  }
  
  .preview-controls {
    bottom: 100rpx;
    padding: 0 20rpx;
  }
  
  .preview-close {
    top: 100rpx;
    right: 20rpx;
  }
  
  .preview-hint {
    top: 100rpx;
  }
}
