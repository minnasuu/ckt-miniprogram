<!-- pages/me/index.wxml -->
<view class="user-center-container" style="padding-top: {{statusBarHeight}}px">
  <view class="content-container">
    <!-- 用户信息区域 -->
    <view class="user-container">
      <view class="user-info" bindtap="handleLogin">
        <view class="avatar-container">
          <view class="avatar-skeleton skeleton-animation" wx:if="{{isLoggingIn}}"></view>
          <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" wx:else></image>
        </view>
        <view class="user-detail">
          <view class="username-skeleton skeleton-animation" wx:if="{{isLoggingIn}}"></view>
          <view class="username" wx:else>{{userInfo.username || '点击登录'}}</view>
        </view>
      </view>
      <view wx:if="{{userInfo}}" class="logout-button" bindtap="showLogoutConfirm"><view class="logout-icon"></view></view>
    </view>
    <!-- 功能按钮区域 -->
    <view class="function-buttons">
      <view class="function-button" bindtap="onFunctionTap" data-type="images">
          <text class="button-text">图片</text>
          <view class="button-num {{imageNum > 0 ? '' : 'empty'}}"><span>{{imageNum > 0 ? imageNum : '-'}}</span></view>
      </view>
      <view class="function-button" bindtap="onFunctionTap" data-type="documents">
          <text class="button-text">图解</text>
          <view class="button-num {{documentNum > 0 ? '' : 'empty'}}"><span>{{documentNum > 0 ? documentNum : '-'}}</span></view>
      </view>
      <view class="function-button" bindtap="onFunctionTap" data-type="assets">
          <text class="button-text">资产</text>
          <view class="button-num {{assetNum > 0 ? '' : 'empty'}}"><span>{{assetNum > 0 ? assetNum : '-'}}</span></view>
      </view>
      <!--<view class="function-button" bindtap="onFunctionTap" data-type="favorite">
          <text class="button-text">收藏</text>
          <view class="button-num {{favoriteNum > 0 ? '' : 'empty'}}"><span>{{favoriteNum > 0 ? favoriteNum : '-'}}</span></view>
      </view>-->
    </view>
    <!-- 后台入口（仅作者可见） -->
    <navigator wx:if="{{userInfo.openId === 'od7SO5Pt8HG7dDS5A_1Uuv7ky_Mg'}}" url="/pages/management/index" class="management-entry">后台入口（仅minna可见）<arrow color="var(--ckt-gray-5)"></arrow></navigator>

    <!-- 创作记录 -->
    <view class="check-in-record" bindtap="showCheckInPanel">
      <view class="check-in-record-title">
        <text>近 7 天创作记录</text>
        <view class="view-detail"><arrow color="var(--ckt-gray-5)"></arrow></view>
      </view>
      <view class="check-in-record-list">
        <view class="check-in-record-item" wx:for="{{weeklyData}}" wx:key="date">
          <view class="check-in-record-item-nums">{{item.creationCount > 0 ? item.creationCount : '-'}}</view>
          <view class="day-info">
            <view class="day-name">{{item.day}}</view>
            <view class="day-num {{item.isToday ? 'today' : ''}}">{{item.dayNum}}</view>
          </view>
          <view class="check-status">
            <view class="status-dot login {{item.hasLogin ? 'active' : ''}}" data-type="登录"></view>
            <view class="status-dot create {{item.hasCreate ? 'active' : ''}}" data-type="创作"></view>
          </view>
        </view>
      </view>
      <view class="check-in-stats">
        <view class="stat-item">
          <view class="stat-num">{{checkInStreak}}</view>
          <view class="stat-label">连续登录天数</view>
        </view>
        <view class="stat-item">
          <view class="stat-num">{{creationStreak}}</view>
          <view class="stat-label">连续创作天数</view>
        </view>
        <view class="stat-item">
          <view class="stat-num">{{totalCreations}}</view>
          <view class="stat-label">总创作次数</view>
        </view>
      </view>
    </view>

    <!-- 创作入口按钮 -->
    <view class="create-entry" bindtap="onCreateTap">
      <view class="create-text">前往创作</view>
    </view>

    <!-- 功能列表 -->
    <view class="function-list"></view>
  </view>
  <custom-tabbar selected="{{2}}"></custom-tabbar>

  <!-- 打卡数据面板 -->
  <view class="check-in-panel-mask" wx:if="{{showCheckInPanel}}" bindtap="closeCheckInPanel">
    <view class="check-in-panel" catchtap="">
      <view class="panel-header">
        <view class="panel-title">近 7 天创作情况</view>
        <close-icon bind:close="closeCheckInPanel" top="{{4}}" right="{{4}}"></close-icon>
      </view>
      
      <view class="feedback-section">
        <view class="feedback-message {{feedbackType}}">{{feedbackMessage}}</view>
      </view>
      
      <view class="weekly-chart">
        <view class="chart-item" wx:for="{{weeklyData}}" wx:key="date">
          <view class="chart-day">{{item.day}}</view>
          <view class="chart-bars">
            <view class="bar login {{item.hasLogin ? 'filled' : ''}}"></view>
            <view class="bar create {{item.hasCreate ? 'filled' : ''}}"></view>
          </view>
          <view class="chart-date {{item.isToday ? 'today' : ''}}">{{item.dayNum}}</view>
        </view>
      </view>
      
      <view class="legend">
        <view class="legend-item">
          <view class="legend-dot login"></view>
          <text>登录</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot create"></view>
          <text>创作</text>
        </view>
      </view>
      
      <view class="panel-stats">
        <view class="panel-stat-item">
          <view class="panel-stat-num">{{checkInStreak}}</view>
          <view class="panel-stat-label">连续登录</view>
        </view>
        <view class="panel-stat-item">
          <view class="panel-stat-num">{{creationStreak}}</view>
          <view class="panel-stat-label">连续创作</view>
        </view>
        <view class="panel-stat-item">
          <view class="panel-stat-num">{{totalCheckIns}}</view>
          <view class="panel-stat-label">总打卡</view>
        </view>
        <view class="panel-stat-item">
          <view class="panel-stat-num">{{totalCreations}}</view>
          <view class="panel-stat-label">总创作</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="dialog-mask" wx:if="{{showDialog}}">
    <view class="dialog">
      <view class="dialog-title">编辑用户信息</view>
      <!-- 编辑头像 -->
      <view class="edit-avatar {{isConfirming ? 'disabled':''}}">
        <image src="{{tempAvatar || userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" class="edit-avatar" bindtap="chooseAvatar"></image>
      </view>
      <!-- 编辑用户名 -->
      <view class="edit-item {{isConfirming ? 'disabled':''}}">
        <text>用户名：</text>
        <input placeholderText="{{userInfo.username}}" value="{{tempUsername}}" bindinput="onUsernameInput" />
      </view>
      <!-- 操作按钮 -->
      <view class="dialog-buttons">
        <button bindtap="cancelEdit" class="button cancel">取消</button>
        <button 
          bindtap="confirmEdit" 
          class="button submit" 
          disabled="{{isConfirming}}"
        >
          {{isConfirming ? '更新中...' : '确定'}}
        </button>
      </view>
      <close-icon bind:close="cancelEdit" top="{{12}}" right="{{4}}"></close-icon>
    </view>
  </view>
</view>