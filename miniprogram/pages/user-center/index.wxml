<!-- pages/me/index.wxml -->
<wxs module="roleUtils">
  function getRoleName(role) {
    if (role === 'admin') {
      return '管理员';
    } else if (role === 'premium') {
      return '高级用户';
    } else {
      return '普通用户';
    }
  }
  
  module.exports = {
    getRoleName: getRoleName
  };
</wxs>

<view class="user-center-container" style="padding-top: {{statusBarHeight}}px">
  <view class="content-container">
    <!-- 用户信息区域 -->
    <view class="user-container">
      <view class="user-info" bindtap="handleLogin">
        <view class="avatar-container">
          <view class="avatar-skeleton skeleton-animation" wx:if="{{isLoggingIn}}"></view>
          <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" wx:else></image>
        </view>
        <view class="user-detail">
          <view class="username-skeleton skeleton-animation" wx:if="{{isLoggingIn}}"></view>
          <view class="username" wx:else>{{userInfo.username || '点击登录'}}</view>
          <view wx:if="{{userInfo}}" class="role-name {{userInfo.role}}">{{roleUtils.getRoleName(userInfo.role)}}</view>
          <view wx:if="{{userInfo}}" class="logout-button" catchtap="showLogoutConfirm"><view class="logout-icon"></view></view>
        </view>
      </view>
    </view>
    <!-- 功能按钮区域 -->
    <view class="function-buttons">
      <view class="function-button" bindtap="onFunctionTap" data-type="images">
          <text class="button-text">图片</text>
          <view class="button-num {{imageNum > 0 ? '' : 'empty'}}"><span>{{imageNum > 0 ? imageNum : '-'}}</span></view>
      </view>
      <view class="function-button" bindtap="onFunctionTap" data-type="documents">
          <text class="button-text">图解</text>
          <view class="button-num {{documentNum > 0 ? '' : 'empty'}}"><span>{{documentNum > 0 ? documentNum : '-'}}</span></view>
      </view>
      <!-- <view class="function-button" bindtap="onFunctionTap" data-type="assets">
