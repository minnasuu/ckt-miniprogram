/* pages/tutorial/knit/knit-detail/index.wxss */
.knit-detail-container {
  width: 100vw;
  height: 100vh;
  padding-top: 88px;
  box-sizing: border-box;
}
.knit-detail-content {
  width: 100%;
  height: calc(100vh - 88px);
  display: flex;
}
/* 左侧导航样式 */
.knit-detail-menu {
  position: relative;
  width: 100px;
  height: 100%;
  border-right: 1px solid var(--ckt-gray-3);
  padding-bottom: 24px;
  padding-top: 12px;
  box-sizing: border-box;
  overflow-y: auto;
}
.knit-detail-menu-indicator {
  position: absolute;
  right: 0;
  top: 0;
  width: 2px;
  height: 36px;
  border-radius: 1px;
  background-color: var(--ckt-theme-6);
  transition: transform 0.2s linear;
}
.knit-detail-menu-item {
  width: 100%;
  height: 48px;
  padding-inline: 16px;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  box-sizing: border-box;
}
.knit-detail-menu-item-active .knit-detail-menu-item-title {
  color: var(--ckt-theme-6);
}
.knit-detail-menu-item-title {
  font-size: 14px;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  width: 100%;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  transition: color 0.2s linear;
}
/* 右侧内容样式 */
.knit-detail-content-right {
  flex: 1;
  height: 100%;
  padding-bottom: 24px;
  box-sizing: border-box;
  overflow-y: auto;
}
.knit-detail-item {
  width: 100%;
}
.knit-detail-item-title {
  padding-inline: 20px;
  padding-block: 16px;
  font-size: 18px;
  font-weight: bold;
  color: var(--ckt-gray-11);
  border-bottom: 1px solid var(--ckt-gray-3);
}
.knit-detail-item-content {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding-inline: 20px;
  padding-top: 20px;
}
.knit-detail-item-desc {
  padding: 12px;
  font-size: 14px;
  color: var(--ckt-gray-7);
  line-height: 1.6;
  background-color: var(--ckt-gray-1);
  border-radius: 8px;
  box-sizing: border-box;
}
.knit-detail-details {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.knit-detail-details-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.knit-detail-details-item-img {
  width: 100%;
  max-width: 400px;
  border-radius: 8px;
}
.knit-detail-details-item-desc {
  font-size: 14px;
  color: var(--ckt-gray-10);
  line-height: 1.5em;
}
/* 页面加载态遮罩 */
.knit-detail-loading-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  z-index: 1000;
}
/* 图片加载占位 */
.knit-detail-img-wrapper {
  position: relative;
  min-height: 120rpx;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--ckt-gray-1);
}
.knit-detail-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(100vw - 140px);
  height: 100%;
  min-height: 120rpx;
  margin-block: auto;
  background: linear-gradient(to right, var(--ckt-gray-1), var(--ckt-gray-2), var(--ckt-gray-1));
  animation: shimmer 2.5s infinite;
  background-size: 200% 100%;
  border-radius: 8px;
}
.knit-detail-details-item-img.hide {
  display: none;
  height: 120rpx;
}
.knit-detail-details-item-img.show {
  display: block;
  transition: opacity 0.2s linear;
}
.knit-detail-img-error {
  color: var(--ckt-red-8);
  font-size: 12px;
}
@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  80%,
  100% {
    background-position: -200% 0;
  }
}
