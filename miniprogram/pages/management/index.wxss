/* pages/management/index.wxss */
.management-view {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background-color: var(--ckt-gray-0);
}
/* 主界面样式 */
.management-view .content {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 24px;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom, 12px);
  overflow: auto;
  gap: 16px;
}
.management-card {
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 12px;
  background-color: var(--ckt-gray-1);
  border-radius: 16px;
  box-sizing: border-box;
  transition: all 0.3s ease;
  border: 2px solid transparent;
}
.management-card:active {
  transform: scale(0.98);
  background-color: var(--ckt-gray-2);
}
.card-icon {
  font-size: 32px;
  margin-bottom: 8px;
}
.card-title {
  font-size: 16px;
  font-weight: bold;
  color: var(--ckt-gray-11);
  text-align: center;
}
.card-desc {
  font-size: 12px;
  color: var(--ckt-gray-8);
  text-align: center;
  line-height: 1.4;
}
/* 用户列表界面样式 */
.user-list-view {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: var(--ckt-gray-0);
}
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 24px;
  background-color: var(--ckt-gray-1);
  border-bottom: 1px solid var(--ckt-gray-3);
}
.header-title {
  font-size: 18px;
  font-weight: bold;
  color: var(--ckt-gray-11);
}
.back-btn {
  font-size: 16px;
  color: var(--ckt-gray-8);
  padding: 8px 12px;
  border-radius: 8px;
  background-color: var(--ckt-gray-2);
}
.search-bar {
  padding: 16px 24px;
  background-color: var(--ckt-gray-1);
  border-bottom: 1px solid var(--ckt-gray-3);
}
.search-input {
  width: 100%;
  height: 40px;
  padding: 0 16px;
  background-color: var(--ckt-gray-2);
  border-radius: 20px;
  font-size: 14px;
  color: var(--ckt-gray-11);
}
.user-list {
  flex: 1;
  overflow-y: auto;
  padding: 16px 24px;
}
.user-item {
  display: flex;
  align-items: center;
  padding: 16px;
  margin-bottom: 12px;
  background-color: var(--ckt-gray-1);
  border-radius: 12px;
  border: 1px solid var(--ckt-gray-3);
  transition: all 0.3s ease;
}
.user-item:active {
  background-color: var(--ckt-gray-2);
  transform: scale(0.98);
}
.user-avatar {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  overflow: hidden;
  margin-right: 16px;
}
.user-avatar image {
  width: 100%;
  height: 100%;
}
.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.user-name {
  font-size: 16px;
  font-weight: bold;
  color: var(--ckt-gray-11);
}
.user-id {
  font-size: 12px;
  color: var(--ckt-gray-6);
  font-family: monospace;
}
.user-role {
  font-size: 12px;
  color: var(--ckt-gray-8);
  background-color: var(--ckt-gray-2);
  padding: 2px 8px;
  border-radius: 12px;
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 4px;
}

.role-label {
  color: var(--ckt-gray-6);
  font-size: 11px;
}

.role-name {
  color: var(--ckt-gray-9);
  font-weight: 500;
}

.user-permissions {
  margin-top: 6px;
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
}

.permission-tag {
  display: inline-block;
  padding: 1px 4px;
  background-color: var(--ckt-gray-3);
  color: var(--ckt-gray-7);
  font-size: 9px;
  border-radius: 6px;
  margin-right: 2px;
  margin-bottom: 1px;
}
.user-actions {
  display: flex;
  align-items: center;
}
.action-btn {
  font-size: 14px;
  color: var(--ckt-gray-8);
  padding: 8px 16px;
  background-color: var(--ckt-gray-2);
  border-radius: 8px;
}
.loading-view {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}
.loading-text {
  font-size: 16px;
  color: var(--ckt-gray-8);
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  text-align: center;
}
.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
  opacity: 0.6;
}
.empty-text {
  font-size: 16px;
  color: var(--ckt-gray-6);
  line-height: 1.5;
}
/* 用户详情界面样式 */
.user-detail-view {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: var(--ckt-gray-0);
}
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 24px;
  background-color: var(--ckt-gray-1);
  border-bottom: 1px solid var(--ckt-gray-3);
}
.user-detail-content {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
}
.user-profile {
  display: flex;
  align-items: center;
  padding: 24px;
  background-color: var(--ckt-gray-1);
  border-radius: 16px;
  margin-bottom: 24px;
}
.profile-avatar {
  width: 80px;
  height: 80px;
  border-radius: 40px;
  overflow: hidden;
  margin-right: 20px;
}
.profile-avatar image {
  width: 100%;
  height: 100%;
}
.profile-info {
  flex: 1;
}
.profile-name {
  font-size: 20px;
  font-weight: bold;
  color: var(--ckt-gray-11);
  margin-bottom: 8px;
}
.profile-id {
  font-size: 14px;
  color: var(--ckt-gray-6);
  font-family: monospace;
}
.role-section {
  background-color: var(--ckt-gray-1);
  border-radius: 16px;
  padding: 24px;
}
.section-title {
  font-size: 18px;
  font-weight: bold;
  color: var(--ckt-gray-11);
  margin-bottom: 16px;
}
.current-role {
  margin-bottom: 24px;
}
.role-badge {
  display: inline-block;
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: bold;
  color: white;
}
.role-badge.normal {
  background-color: var(--ckt-gray-6);
}
.role-badge.premium {
  background-color: #FF6B35;
}
.role-badge.admin {
  background-color: #4ECDC4;
}
.role-options {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.role-option-item {
  padding: 16px;
  border: 2px solid var(--ckt-gray-3);
  border-radius: 12px;
  background-color: var(--ckt-gray-2);
  transition: all 0.3s ease;
}
.role-option-item.active {
  border-color: #4ECDC4;
  background-color: rgba(78, 205, 196, 0.1);
}
.role-option-item:active {
  transform: scale(0.98);
}
.role-name {
  font-size: 16px;
  font-weight: bold;
  color: var(--ckt-gray-11);
  margin-bottom: 8px;
}
.role-permissions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.permission-tag {
  font-size: 12px;
  color: var(--ckt-gray-8);
  background-color: var(--ckt-gray-3);
  padding: 2px 8px;
  border-radius: 10px;
}
/* 权限配置界面样式 */
.permission-config-view {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: var(--ckt-gray-0);
}
.config-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 24px;
  background-color: var(--ckt-gray-1);
  border-bottom: 1px solid var(--ckt-gray-3);
}
.permission-content {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
}
.role-section {
  background-color: var(--ckt-gray-1);
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 16px;
}
.role-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--ckt-gray-3);
}
.role-name {
  font-size: 18px;
  font-weight: bold;
  color: var(--ckt-gray-11);
}
.role-key {
  font-size: 12px;
  color: var(--ckt-gray-6);
  background-color: var(--ckt-gray-2);
  padding: 4px 8px;
  border-radius: 8px;
  font-family: monospace;
}
.permissions-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.permission-item {
  background-color: var(--ckt-gray-2);
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid var(--ckt-gray-3);
}
.permission-name {
  font-size: 12px;
  color: var(--ckt-gray-8);
}
/* 上传图片样式 */
.upload-image-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}
.upload-image-list .upload-image-item {
  aspect-ratio: 1;
  background-color: var(--ckt-gray-1);
  border-radius: 8px;
}
.upload-image-list .upload-image-item image {
  width: 100%;
  height: 100%;
}
