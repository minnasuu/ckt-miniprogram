/* pages/management/index.wxss */
.management-view {
  width: 100vw;
  height: 100vh;
  box-sizing: border-box;
}
.management-view .content {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  width: 100%;
  height: 100%;
  padding-inline: 24px;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom, 12px);
  overflow: auto;
}
.management-view .content .item {
  padding: 16px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  width: 100%;
  margin: 0;
  aspect-ratio: 2;
  background-color: var(--ckt-gray-1);
  border-radius: 12px;
  box-sizing: border-box;
}
.management-view .content .item .title {
  font-size: 16px;
  font-weight: bold;
  color: var(--ckt-gray-11);
}
.management-view .content .item .desc {
  font-size: 14px;
  color: var(--ckt-gray-8);
}
.upload-image-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}
.upload-image-list .upload-image-item {
  aspect-ratio: 1;
  background-color: var(--ckt-gray-1);
  border-radius: 8px;
}
.upload-image-list .upload-image-item image {
  width: 100%;
  height: 100%;
}
