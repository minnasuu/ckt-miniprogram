<!-- 测试登录功能的页面 -->
<view class="container">
  <view class="header">
    <text class="title">登录功能测试</text>
  </view>

  <view class="status-section">
    <view class="status-item">
      <text class="label">登录状态：</text>
      <text class="value {{loginStatus === '已登录' ? 'success' : 'error'}}">{{loginStatus}}</text>
    </view>
    
    <view class="status-item" wx:if="{{userInfo}}">
      <text class="label">用户ID：</text>
      <text class="value">{{userInfo.openId}}</text>
    </view>
    
    <view class="status-item" wx:if="{{userInfo}}">
      <text class="label">用户名：</text>
      <text class="value">{{userInfo.username}}</text>
    </view>
  </view>

  <view class="button-section">
    <button 
      class="login-btn {{isLoggingIn ? 'loading' : ''}}" 
      bindtap="performBasicLogin"
      disabled="{{isLoggingIn}}"
    >
      {{isLoggingIn ? '登录中...' : '基础登录（默认信息）'}}
    </button>
    
    <button 
      class="userinfo-btn {{isLoggingIn ? 'loading' : ''}}" 
      bindtap="performLoginWithUserInfo"
      disabled="{{isLoggingIn}}"
    >
      {{isLoggingIn ? '登录中...' : '引导填写用户信息'}}
    </button>
    
    <button 
      class="logout-btn" 
      bindtap="logout"
      wx:if="{{userInfo}}"
    >
      退出登录
    </button>
    
    <button 
      class="check-btn" 
      bindtap="checkLoginStatus"
    >
      检查登录状态
    </button>
  </view>

  <view class="logs-section">
    <view class="logs-header">
      <text class="logs-title">操作日志</text>
      <button class="clear-btn" bindtap="clearLogs">清除</button>
    </view>
    
    <scroll-view class="logs-content" scroll-y="true">
      <view class="log-item" wx:for="{{logs}}" wx:key="index">
        {{item}}
      </view>
    </scroll-view>
  </view>
</view>
