.test-container {
  padding: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-top: 100rpx;
}

.test-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
  color: #333;
}

.test-section {
  background-color: white;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 16px;
}

.section-title {
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 12px;
  color: #333;
}

.status-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.status-info text {
  font-size: 26rpx;
  color: #666;
  padding: 6px 8px;
  background-color: #f8f8f8;
  border-radius: 8rpx;
}

.button-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.test-btn {
  padding: 12px;
  border-radius: 8px;
  font-size: 14px;
  background-color: var(--ckt-gray-2);
  color: #333;
  border: none;
}

.test-btn.primary {
  background-color: var(--ckt-theme-6);
  color: white;
}

.test-btn:active {
  opacity: 0.8;
}
