<view class="test-container">
  <view class="test-title">启动页路由测试</view>
  
  <view class="test-section">
    <view class="section-title">当前状态</view>
    <view class="status-info">
      <text>登录状态: {{isLoggedIn ? '已登录' : '未登录'}}</text>
      <text>最近7天创作: {{hasRecentCreation ? '有记录' : '无记录'}}</text>
      <text>预期跳转: {{expectedRoute}}</text>
    </view>
  </view>

  <view class="test-section">
    <view class="section-title">模拟状态</view>
    <view class="button-group">
      <button class="test-btn" bindtap="simulateLogout">模拟未登录</button>
      <button class="test-btn" bindtap="simulateLoginNoCreation">登录无创作</button>
      <button class="test-btn" bindtap="simulateLoginWithCreation">登录有创作</button>
    </view>
  </view>

  <view class="test-section">
    <view class="section-title">测试操作</view>
    <view class="button-group">
      <button class="test-btn primary" bindtap="testNewLogin">测试新登录功能</button>
      <button class="test-btn" bindtap="testLaunchLogic">测试路由逻辑</button>
      <button class="test-btn" bindtap="goToLaunchPage">前往启动页</button>
      <button class="test-btn" bindtap="clearAllData">清空所有数据</button>
    </view>
  </view>

  <view class="test-section">
    <view class="section-title">云函数测试</view>
    <view class="button-group">
      <button class="test-btn" bindtap="testConnection">测试云函数连接</button>
      <button class="test-btn" bindtap="testUserManagement">测试用户管理云函数</button>
      <button class="test-btn primary" bindtap="createTestUsers">创建测试用户</button>
    </view>
    <view class="test-result" wx:if="{{testResult}}">
      <text>测试结果: {{testResult}}</text>
    </view>
  </view>
</view>
